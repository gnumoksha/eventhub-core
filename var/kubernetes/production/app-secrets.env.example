# Copy this file to app-secrets.env, replace the placeholder values, and keep
# the copied file out of Git. Use hexadecimal passwords so the DSNs need no URL
# escaping. Each password must match its value in DATABASE_URL or RABBITMQ_DSN.
APP_SECRET=replace-with-a-random-64-character-hex-string
POSTGRES_PASSWORD=replace-with-a-random-hex-database-password
RABBITMQ_DEFAULT_PASS=replace-with-a-random-hex-rabbitmq-password
DATABASE_URL=postgresql://eventhub:replace-with-a-random-hex-database-password@postgresql:5432/eventhub
RABBITMQ_DSN=amqp://eventhub:replace-with-a-random-hex-rabbitmq-password@rabbitmq:5672/%2F
