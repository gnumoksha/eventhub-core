#!/usr/bin/env bash
# i18n Management Script
# This script helps manage translations for the project

set -e

has() {
  # Check if a command exists
  command -v "$@" 1>/dev/null 2>&1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
LOCALES_DIR="$PROJECT_ROOT/locales"
POT_FILE="$LOCALES_DIR/messages.pot"

# In the production docker image, uv may not be available
if has uv; then
    PREFIX="uv run"
else
    PREFIX=""
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

function print_usage {
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  extract     - Extract messages from source code to POT file"
    echo "  update      - Update existing translation files with new messages"
    echo "  compile     - Compile translation files to binary format"
    echo "  init <lang> - Initialize a new language (e.g., init pt_BR)"
    echo "  stats       - Show translation statistics"
    echo ""
    echo "Examples:"
    echo "  $0 extract"
    echo "  $0 init pt_BR"
    echo "  $0 update"
    echo "  $0 compile"
    echo "  $0 stats"
}

function extract_messages {
    echo -e "${GREEN}Extracting messages from source code...${NC}"
    cd "$PROJECT_ROOT"
    $PREFIX pybabel extract -F babel.cfg -k t -o "$POT_FILE" src/ packages/
    echo -e "${GREEN}✓ Messages extracted to $POT_FILE${NC}"
}

function update_translations {
    echo -e "${GREEN}Updating translation files...${NC}"
    cd "$PROJECT_ROOT"
    $PREFIX pybabel update -i "$POT_FILE" -d "$LOCALES_DIR"
    echo -e "${GREEN}✓ Translation files updated${NC}"
}

function compile_translations {
    echo -e "${GREEN}Compiling translation files...${NC}"
    cd "$PROJECT_ROOT"
    $PREFIX pybabel compile -d "$LOCALES_DIR"
    echo -e "${GREEN}✓ Translation files compiled${NC}"
}

function init_language {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: Language code required${NC}"
        echo "Example: $0 init pt_BR"
        exit 1
    fi

    LANG_CODE="$1"
    echo -e "${GREEN}Initializing translation for language: $LANG_CODE${NC}"
    cd "$PROJECT_ROOT"

    if [ -d "$LOCALES_DIR/$LANG_CODE" ]; then
        echo -e "${YELLOW}Warning: Language $LANG_CODE already exists${NC}"
        exit 1
    fi

    $PREFIX pybabel init -i "$POT_FILE" -d "$LOCALES_DIR" -l "$LANG_CODE"
    echo -e "${GREEN}✓ Language $LANG_CODE initialized${NC}"
    echo -e "${YELLOW}Next steps:${NC}"
    echo "  1. Edit locales/$LANG_CODE/LC_MESSAGES/messages.po"
    echo "  2. Run: $0 compile"
}

function show_stats {
    echo -e "${GREEN}Translation Statistics${NC}"
    echo ""

    for po_file in "$LOCALES_DIR"/*/LC_MESSAGES/messages.po; do
        if [ -f "$po_file" ]; then
            lang=$(basename "$(dirname "$(dirname "$po_file")")")
            echo -e "${YELLOW}Language: $lang${NC}"
            $PREFIX msgfmt --statistics "$po_file" 2>&1 | grep -v "done"
            echo ""
        fi
    done
}

case "${1:-}" in
    extract)
        extract_messages
        ;;
    update)
        update_translations
        ;;
    compile)
        compile_translations
        ;;
    init)
        init_language "$2"
        ;;
    stats)
        show_stats
        ;;
    *)
        print_usage
        exit 1
        ;;
esac
