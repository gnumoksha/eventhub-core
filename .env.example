APP_ENV=development
APP_VERSION=0.0.0
APP_DEBUG=false
APP_SECRET=foobarbaz

LOGGING_LEVEL=INFO

PUBLIC_URL=http://eventhub.localhost:8000
CORS_ALLOWED_ORIGINS="http://eventhub.localhost:3000,http://localhost:3000"

DATABASE_URL=postgresql://eventhub:eventhub@127.0.0.1:5432/eventhub

RABBITMQ_DSN="amqp://eventhub:eventhub@rabbitmq:5672/%2F"
QUEUE_RESULT_BACKEND_DSN="redis://redis:6379/0"

#SENTRY_DSN=

RESEND_API_KEY=re_replace-with-your-resend-api-key
NOTIFICATIONS_FROM_EMAIL=Eventhub <no-reply@example.com>
